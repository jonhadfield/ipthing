[Unit]
Description=IPThing Server
Documentation=https://github.com/jonhadfield/ipthing
After=network.target

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Type=simple
User=ipthing
Group=ipthing
WorkingDirectory=/opt/ipthing
ExecStart=/opt/ipthing/ipthing
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Environment
EnvironmentFile=-/etc/ipthing/env

[Install]
WantedBy=multi-user.target
