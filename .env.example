# IPThing Environment Configuration
# Copy this file to .env and configure as needed

# Database Configuration
# Uncomment and configure the database type you want to use

# SQLite
# IPTHING_DB_TYPE=sqlite
# IPTHING_SQLITE_PATH=/path/to/database.db

# PostgreSQL
# IPTHING_DB_TYPE=postgres
# IPTHING_POSTGRES_URL=postgres://username:password@localhost:5432/dbname
# or use the standard DATABASE_URL
# DATABASE_URL=postgres://username:password@localhost:5432/dbname

# MariaDB/MySQL (connection string uses the same env var as Postgres)
# IPTHING_DB_TYPE=mariadb
# IPTHING_POSTGRES_URL=username:password@tcp(localhost:3306)/dbname

# Server Port Configuration (defaults: HTTP 8080, HTTPS 443)
# IPTHING_HTTP_PORT=8080
# IPTHING_HTTPS_PORT=443

# AutoTLS host whitelist (comma-separated)
# IPTHING_HOST_WHITELIST=ipthing.net,www.ipthing.net

# Note: .env file is automatically loaded by the application
# See config.go for all available configuration options
